    {
      "id": "da0c09a1-37ce-4283-9412-0ed434ac5695",
      "name": "Armar datos de la factura",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        128
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $('⚙️ Configuración').item.json.properties || {};\nconst c = $json.object === 'page' ? ($json.properties || {}) : null;\nconst txt = (prop) => ((prop && (prop.rich_text || prop.title)) || []).map(t => t.plain_text).join('').trim();\nconst sel = (prop) => (prop && prop.select && prop.select.name) || '';\nconst hoy = $now.setZone('America/Argentina/Buenos_Aires').toISODate();\nconst fail = (msg) => ({ json: { ok: false, error: msg } });\n\nif (!c) return fail('La factura no tiene un cliente elegido (o n8n no tiene acceso a la base Clientes).');\n\nconst importe = p['Importe'] ? p['Importe'].number : null;\nif (!importe || importe <= 0) return fail('El importe está vacío o en cero.');\n\nconst periodo = (p['Período'] && p['Período'].date) || {};\nconst vence = p['Vence'] && p['Vence'].date ? p['Vence'].date.start : null;\n\nreturn {\n  json: {\n    ok: true,\n    body: {\n      importe: Math.round(importe * 100) / 100,\n      moneda: 'ARS',\n      descripcion: txt(p['Concepto']) || 'Servicios',\n      periodoDesde: periodo.start || hoy,\n      periodoHasta: periodo.end || periodo.start || hoy,\n      vencimiento: vence && vence >= hoy ? vence : hoy,\n      receptor: {\n        nombre: txt(c['Razón social']) || txt(c['Nombre']),\n        tipoDocumento: sel(c['Tipo de documento']),\n        nroDocumento: txt(c['Nro de documento']),\n        condicionIva: sel(c['Condición IVA']),\n        domicilio: txt(c['Domicilio fiscal'])\n      }\n    }\n  }\n};"
      }
    },

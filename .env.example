# Entorno: "homologacion" (pruebas) o "produccion"
ARCA_ENV=homologacion

# CUIT del emisor (solo números)
ARCA_CUIT=20123456789

# Punto de venta tipo Web Services (en homologación cualquier número sirve, ej. 1)
ARCA_PTO_VTA=1

# Certificado y clave privada en PEM. En Vercel pegalos completos (con las líneas BEGIN/END).
# Alternativa: en base64 con ARCA_CERT_B64 / ARCA_KEY_B64
ARCA_CERT=
ARCA_KEY=

# Clave compartida que n8n manda en el header x-api-key
API_SECRET=

# Datos del emisor para el PDF
EMISOR_RAZON_SOCIAL=Felipe Apellido
EMISOR_DOMICILIO=Calle 123, CABA
EMISOR_INICIO_ACTIVIDADES=01/01/2020
EMISOR_IIBB=Exento
EMISOR_CONDICION_IVA=Responsable Monotributo

# Opcional: caché del ticket de acceso (recomendado en Vercel). Upstash Redis REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
